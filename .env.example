# Copy this file to .env and fill in your values before running docker compose up

# Required
OPENAI_API_KEY=sk-...

# Cloudinary (for profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (for password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend
# Path to the frontend repo on the host — used to build the frontend image
FRONTEND_DIR=/path/to/fociumfr
# URL the browser uses to reach the API (must be publicly reachable)
NEXT_PUBLIC_API_URL=http://your-server-ip:8080
FRONTEND_URL=http://your-server-ip:3000
